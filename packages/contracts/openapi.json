{
  "components": {
    "schemas": {
      "Artifact": {
        "additionalProperties": false,
        "properties": {
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/Statement"
            },
            "maxItems": 100,
            "title": "Dependencies",
            "type": "array"
          },
          "edge_cases": {
            "items": {
              "$ref": "#/components/schemas/Statement"
            },
            "maxItems": 100,
            "title": "Edge Cases",
            "type": "array"
          },
          "non_goals": {
            "items": {
              "$ref": "#/components/schemas/Statement"
            },
            "maxItems": 100,
            "title": "Non Goals",
            "type": "array"
          },
          "open_questions": {
            "items": {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 100,
            "title": "Open Questions",
            "type": "array"
          },
          "purpose": {
            "maxLength": 16384,
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/Requirement"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Requirements",
            "type": "array"
          },
          "risks": {
            "items": {
              "$ref": "#/components/schemas/Statement"
            },
            "maxItems": 100,
            "title": "Risks",
            "type": "array"
          },
          "scope": {
            "items": {
              "$ref": "#/components/schemas/Statement"
            },
            "maxItems": 100,
            "title": "Scope",
            "type": "array"
          },
          "stories": {
            "items": {
              "$ref": "#/components/schemas/Story"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Stories",
            "type": "array"
          },
          "success_metrics": {
            "items": {
              "$ref": "#/components/schemas/Statement"
            },
            "maxItems": 100,
            "title": "Success Metrics",
            "type": "array"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "purpose",
          "scope",
          "non_goals",
          "requirements",
          "stories",
          "edge_cases",
          "dependencies",
          "risks",
          "success_metrics",
          "open_questions"
        ],
        "title": "Artifact",
        "type": "object"
      },
      "Finding": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "severity": {
            "default": "warning",
            "enum": [
              "warning",
              "error"
            ],
            "title": "Severity",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "Finding",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Project": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Project",
        "type": "object"
      },
      "ProjectCreate": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectCreate",
        "type": "object"
      },
      "Requirement": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^REQ-[a-zA-Z0-9-]{1,64}$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "default": "recommendation",
            "enum": [
              "user_provided",
              "verified",
              "recommendation",
              "assumption",
              "unknown"
            ],
            "title": "Kind",
            "type": "string"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Source Ids",
            "type": "array"
          },
          "text": {
            "maxLength": 16384,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "id"
        ],
        "title": "Requirement",
        "type": "object"
      },
      "Revision": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/Artifact"
          },
          "digest": {
            "title": "Digest",
            "type": "string"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string"
          },
          "provenance": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Provenance",
            "type": "object"
          }
        },
        "required": [
          "id",
          "project_id",
          "number",
          "digest",
          "artifact"
        ],
        "title": "Revision",
        "type": "object"
      },
      "RevisionEdit": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/Artifact"
          },
          "expected_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Expected Digest",
            "type": "string"
          }
        },
        "required": [
          "expected_digest",
          "artifact"
        ],
        "title": "RevisionEdit",
        "type": "object"
      },
      "Source": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "title": "Digest",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "const": "user_provided",
            "default": "user_provided",
            "title": "Kind",
            "type": "string"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "text",
          "digest"
        ],
        "title": "Source",
        "type": "object"
      },
      "SourceCreate": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 16384,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "SourceCreate",
        "type": "object"
      },
      "Statement": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "default": "recommendation",
            "enum": [
              "user_provided",
              "verified",
              "recommendation",
              "assumption",
              "unknown"
            ],
            "title": "Kind",
            "type": "string"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Source Ids",
            "type": "array"
          },
          "text": {
            "maxLength": 16384,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "Statement",
        "type": "object"
      },
      "Story": {
        "additionalProperties": false,
        "properties": {
          "acceptance_criteria": {
            "items": {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Acceptance Criteria",
            "type": "array"
          },
          "id": {
            "pattern": "^STORY-[a-zA-Z0-9-]{1,64}$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "default": "recommendation",
            "enum": [
              "user_provided",
              "verified",
              "recommendation",
              "assumption",
              "unknown"
            ],
            "title": "Kind",
            "type": "string"
          },
          "requirement_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Requirement Ids",
            "type": "array"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Source Ids",
            "type": "array"
          },
          "text": {
            "maxLength": 16384,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "id",
          "requirement_ids",
          "acceptance_criteria"
        ],
        "title": "Story",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SpecBridge",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
