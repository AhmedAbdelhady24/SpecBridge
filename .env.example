# Copy these settings into .env and add your key locally. Never commit .env.
SPECBRIDGE_PROVIDER=compatible
SPECBRIDGE_LLM_BASE_URL=https://api.deepseek.com
SPECBRIDGE_LLM_MODEL=deepseek-flash
SPECBRIDGE_LLM_API_KEY=
SPECBRIDGE_LLM_OUTPUT_MODE=json_object
# Calibrated from one completed 1469-token synthetic response, with ~2x headroom.
SPECBRIDGE_LLM_MAX_TOKENS=3072
# Explicitly disable DeepSeek thinking for the initial bounded trial.
SPECBRIDGE_LLM_REASONING_EFFORT=none

# Load explicitly from the repository root:
# PYTHONPATH=services/api uv run --env-file .env python -m specbridge
# Other strict-schema endpoints can use SPECBRIDGE_LLM_OUTPUT_MODE=json_schema.
# Token cap: 1..16384; output/usage semantics depend on the selected provider.
# Configuration is prepared; live compatibility and output quality need testing.
